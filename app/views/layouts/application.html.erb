<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Comments App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased">
    <nav class="bg-white shadow mb-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to "CommentsApp", root_path, class: "text-xl font-bold text-indigo-600" %>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-sm text-gray-500">@<%= current_user.username %></span>
              
              <%= link_to notifications_path, class: "relative text-gray-600 hover:text-gray-900" do %>
                Notifications
                <% unread_count = current_user.notifications.unread.count %>
                <% if unread_count > 0 %>
                  <span class="absolute -top-2 -right-3 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-red-100 bg-red-600 rounded-full">
                    <%= unread_count %>
                  </span>
                <% end %>
              <% end %>

              <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-sm text-red-600 hover:text-red-800" %>
            <% else %>
              <%= link_to "Login", new_user_session_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
              <%= link_to "Sign up", new_user_registration_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
      <% flash.each do |type, msg| %>
        <div class="p-4 rounded-md <%= type == 'notice' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' %>">
          <%= msg %>
        </div>
      <% end %>
    </div>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
